{
  "name": "foton",
  "private": true,
  "scripts": {
    "dev": "pnpm build:wasm && turbo run dev --filter=@foton/web",
    "build": "pnpm build:wasm && turbo run build",
    "build:wasm": "node scripts/build-wasm.mjs",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test:rust": "cargo test --workspace",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "turbo": "^2.11.10",
    "typescript": "^5"
  },
  "packageManager": "pnpm@11.25.0"
}
